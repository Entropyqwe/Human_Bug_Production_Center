{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenCV program",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-ID:/opencv/build/x64/mingw5/install/include",
                "-LD:/opencv/build/x64/mingw5/install/x64/mingw/lib",
                "-lopencv_highgui500",
                "-lopencv_videoio500",
                "-lopencv_imgcodecs500",
                "-lopencv_imgproc500",
                "-lopencv_core500",
                "-o",
                "${workspaceFolder}/opencv_app.exe"
            ],
            "options": {
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;D:/opencv/build/x64/mingw5/install/x64/mingw/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
